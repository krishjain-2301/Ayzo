# ==========================================
# AYZO Local Mode — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# .env is git-ignored — it will never be committed.

# ---- App ----
DEBUG=True

# ---- Database (SQLite — zero setup) ----
DATABASE_URL=sqlite+aiosqlite:///./ayzo.db

# ---- LLM / AI ----
# Add your keys for the models you want to TEST against (target models).
# The evaluator/mutator (attack brain) uses Groq by default — it's free.
# Get a free Groq key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: if you want to test OpenAI or Gemini targets
OPENAI_API_KEY=
GEMINI_API_KEY=

# Which model evaluates attack results and generates mutations
DEFAULT_EVAL_MODEL=groq/llama-3.3-70b-versatile
MUTATOR_MODEL=groq/llama-3.3-70b-versatile

# Cap YAML payloads per category (0 = unlimited). Keep CI scans bounded.
MAX_PAYLOADS_PER_CATEGORY=20
# Fail the CI job when risk_score is strictly greater than this (0-100).
CICD_FAIL_RISK_THRESHOLD=40

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ---- IDE / Python Path ----
PYTHONPATH=./apps/api

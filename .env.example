# ==========================================
# AYZO Environment Variables Example
# ==========================================
# Copy this file to .env and fill in the actual values.
# Do NOT commit your actual .env file to version control.

# ---- App Settings ----
# Set to False in production
DEBUG=True

# ---- Security ----
# Generate a real secret before deploying to production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# NextAuth / Next.js Secret (if applicable)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ---- Database ----
# PostgreSQL Docker Setup
POSTGRES_USER=ayzo
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ayzo

# Database Connection URL
# If using Docker compose setup above, it should match those credentials
DATABASE_URL=postgresql+asyncpg://ayzo:your_secure_password_here@localhost:5432/ayzo

# ---- Redis & Celery ----
# URLs for Redis and Celery message broker (used by background tasks)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Authentication / OAuth ----
# Google OAuth (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Supabase Auth (Optional, if using Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ---- LLM / AI Providers ----
# OpenAI Key for models (if using OpenAI backend)
OPENAI_API_KEY=your_openai_api_key

# Gemini API Key for proxy/shield or evaluations
GEMINI_API_KEY=your_gemini_api_key

# Default models for evaluation and mutation
DEFAULT_EVAL_MODEL=ollama/llama3.2
MUTATOR_MODEL=ollama/llama3.2

# ---- Next.js Frontend (apps/web) ----
# Next.js will pick up these variables if they are prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# AYZO API settings. Copy to apps/api/.env.

# ---- Judge ----
# A second model decides whether each attack worked. Scans stop before
# attacking if it cannot be reached.
# Groq has a free tier: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Groq:   groq/llama-3.3-70b-versatile
# Ollama: ollama/llama3.2   (run: ollama pull llama3.2)
# OpenAI: gpt-4o-mini
DEFAULT_EVAL_MODEL=groq/llama-3.3-70b-versatile
# Writes mutations and plays the attacker in agentic runs.
MUTATOR_MODEL=groq/llama-3.3-70b-versatile

# ---- Scans ----
# Payloads per category, most severe first. 0 = all.
MAX_PAYLOADS_PER_CATEGORY=20
MAX_CONCURRENT_ATTACKS=5
# The CI gate fails when the risk score is above this (0-100).
CICD_FAIL_RISK_THRESHOLD=40

# ---- Storage / CORS ----
DATABASE_URL=sqlite+aiosqlite:///./ayzo.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

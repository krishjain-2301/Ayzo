# ==================================================
# AYZO API — Environment Variables (Local Mode)
# ==================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored — it will never be committed.
#
# cp .env.example .env
# ==================================================

# ---- Database ----
# SQLite — zero setup, just works. File is created automatically on first run.
DATABASE_URL=sqlite+aiosqlite:///./ayzo.db

# Fernet encryption for API keys at rest (crypto.py). Change in production.
SECRET_KEY=change-me-in-production

# ---- LLM / AI ----
# AYZO uses an LLM to judge whether attacks succeeded.
# Groq is the recommended provider — it's free and fast.
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: uncomment if you want to use OpenAI or Gemini as the judge
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Which model to use as the evaluation judge
# Groq (free):     groq/llama-3.3-70b-versatile
# Ollama (local):  ollama/llama3.2   (run: ollama pull llama3.2)
# OpenAI:          gpt-4o-mini
DEFAULT_EVAL_MODEL=groq/llama-3.3-70b-versatile
MUTATOR_MODEL=groq/llama-3.3-70b-versatile

MAX_PAYLOADS_PER_CATEGORY=20
CICD_FAIL_RISK_THRESHOLD=40

# ---- CORS ----
# Allowed frontend origins (comma separated if multiple)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

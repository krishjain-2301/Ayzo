# AYZO API settings. Copy to apps/api/.env.

# ---- Judge ----
# A second model decides whether each attack worked. Scans stop before
# attacking if it cannot be reached.
# Only needed if you choose a cloud model below.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Ollama (local, free):        ollama/gemma3:4b      (run: ollama pull gemma3:4b)
# Claude Code CLI (no API key): claude-cli/haiku
# Groq / OpenAI (need a key):   groq/llama-3.3-70b-versatile, gpt-4o-mini
# Measure any of them with: python -m app.judge_bench --model <name>
DEFAULT_EVAL_MODEL=ollama/gemma3:4b
# Writes mutations and plays the attacker in agentic runs.
MUTATOR_MODEL=ollama/gemma3:4b

# ---- Scans ----
# Payloads per category, most severe first. 0 = all.
MAX_PAYLOADS_PER_CATEGORY=20
MAX_CONCURRENT_ATTACKS=5
# The CI gate fails when the risk score is above this (0-100).
CICD_FAIL_RISK_THRESHOLD=40

# ---- Storage / CORS ----
DATABASE_URL=sqlite+aiosqlite:///./ayzo.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

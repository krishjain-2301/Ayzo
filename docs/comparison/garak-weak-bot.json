{
  "rest": {
    "RestGenerator": {
      "name": "practice-weak",
      "uri": "http://127.0.0.1:5001/chat",
      "method": "post",
      "headers": { "Content-Type": "application/json" },
      "req_template_json_object": { "message": "$INPUT" },
      "response_json": true,
      "response_json_field": "response",
      "request_timeout": 180
    }
  }
}
